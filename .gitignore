# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated journeys (fs JourneyStore adapter)
/data/journeys

# Archive data: the raw crawl cache and everything derived from it.
# Regenerate with `npm run ingest:playlists` then `npm run ingest -- --offline`.
# Too large for git (cache ~400MB, index ~63MB) and reproducible from source.
/data/.ingest-cache.jsonl
/data/.ingest-state.json
/data/index.json
# ...but the gzipped archive IS tracked: 19.9 MB, so the repo carries its own
# data and any host can build without a separate download step.
!/data/index.json.gz
/data/unmatched.json

# Backfill working files, derived from a YouTube Studio export.
# Regenerate with: python3 scripts/parse-studio-export.py <export.xlsx>
/data/backfill/
